{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Local debug 🖥️",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "macropad.py",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run"
            ],
            "autoStartBrowser": false
        },
        {
            "name": "Remote debugger attach 🌐",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "."
                }
            ]
        }
    ]
}
