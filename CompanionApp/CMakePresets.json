{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "description": "Sets Ninja generator and build and install dirs",
            "generator": "Ninja",
            "binaryDir": "build/${presetName}",
            "installDir": "build/${presetName}/deploy"
        },
        {
            "name": "debug",
            "hidden": true,
            "description": "Debug build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "hidden": true,
            "description": "Release build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "win64",
            "hidden": true,
            "description": "Windows x64 architecture",
            "architecture":{
                "value": "x64",
                "strategy": "external"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux",
            "hidden": true,
            "description": "Linux x64 architecture",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "msvc",
            "hidden": true,
            "description": "Windows MSVC Compiler",
            "toolset": {
                "strategy": "external",
                "value": "host=x64"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl"
            }
        },
        {
            "name": "g++",
            "hidden": true,
            "description": "Linux g++ Compiler",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "win-x64-debug",
            "displayName": "Win64 Debug",
            "description": "Windows x64 MSVC Debug build",
            "inherits": [
                "base",
                "win64",
                "debug",
                "msvc"
            ]
        },
        {
            "name": "win-x64-release",
            "displayName": "Win64 Release",
            "description": "Windows x64 MSVC Release build",
            "inherits": [
                "base",
                "win64",
                "release",
                "msvc"
            ]
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "description": "Linux Debug build",
            "inherits": [
                "base",
                "linux",
                "debug",
                "g++"
            ]
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release",
            "description": "Linux Release build",
            "inherits": [
                "base",
                "linux",
                "release",
                "g++"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "macropad-win64-debug",
            "displayName": "Macropad Companion Win64 Debug",
            "configurePreset": "win-x64-debug",
            "configuration": "Debug",
            "targets": ["Companion"]
        },
        {
            "name": "macropad-win64-release",
            "displayName": "Macropad Companion Wind64 Release",
            "configurePreset": "win-x64-release",
            "configuration": "Release",
            "targets": ["Companion"]
        },
        {
            "name": "win64-deploy",
            "displayName": "Macropad Companion Wind64 Deployment",
            "configurePreset": "win-x64-release",
            "configuration": "Release",
            "targets": ["install"]
        },
        {
            "name": "macropad-linux-debug",
            "displayName": "Macropad Companion Linux Debug",
            "configurePreset": "linux-debug",
            "configuration": "Debug",
            "targets": ["Companion"]
        },
        {
            "name": "macropad-linux-release",
            "displayName": "Macropad Companion Linux Release",
            "configurePreset": "linux-release",
            "configuration": "Release",
            "targets": ["Companion"]
        },
        {
            "name": "linux-deploy",
            "displayName": "Macropad Companion Linux Deployment",
            "configurePreset": "linux-release",
            "configuration": "Release",
            "targets": ["install"]
        }
    ]
}
